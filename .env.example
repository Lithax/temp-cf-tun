# ------------------------------------------------------------------
# Shared by basic/ and advanced-services/ (symlink it into both dirs,
# see symlinks.sh). Never commit the real .env.
# ------------------------------------------------------------------

# --- shared --------------------------------------------------------
SERVICE_URL="https://proxy-cftunnel:9443"  # what the cloudflared tunnel targets
ACCOUNT_ID=""            # Cloudflare account id
NAMESPACE_ID=""          # Workers KV namespace id (carries the current tunnel URL)
API_TOKEN=""             # Cloudflare API token. Needs:
                         #   Workers Scripts:Edit    (advanced: cf-worker/deploy.sh)
                         #   Workers KV Storage:Edit (cftunnel container, both flavors)
                         #   Secrets Store:Edit      (advanced: cf-worker/deploy.sh)

# --- advanced-services only ----------------------------------------
WORKER_NAME=""           # e.g. personal -> personal.<subdomain>.workers.dev
STORE_NAME=""            # Secrets Store name (default: <WORKER_NAME>-secrets)

# Both secrets below are pushed to the Worker's Secrets Store by
# cf-worker/deploy.sh (re-run it to rotate). They must be 24+ chars of
# A-Z a-z 0-9 _ - (try: openssl rand -hex 32):
URL_SECRET=""            # the gate: wrong/missing -> 401 at the edge,
                         # the tunnel and nginx are never bothered
PROXY_TUNNEL_SECRET=""   # the Worker stamps it as X-Tunnel-Secret; nginx 444s
                         # any request without it (kills direct tunnel hits)

# Fixed Host header the tunnel forwards to nginx (nginx matches it as
# server_name). Quick-tunnel hostnames change every restart, so keep this
# set; the default is "proxy-cftunnel".
HTTP_HOST_HEADER="proxy-cftunnel"
