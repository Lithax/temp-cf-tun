# ------------------------------------------------------------------
# advanced-oauth/.env  (compose reads it from this folder; cp .env.example .env)
# Never commit the real .env.
# ------------------------------------------------------------------

SERVICE_URL="https://proxy-cftunnel:9443"  # what the cloudflared tunnel targets
ACCOUNT_ID=""            # Cloudflare account id
NAMESPACE_ID=""          # Workers KV namespace id (carries the current tunnel URL;
                         # also goes into cf-worker/wrangler.jsonc as TUNNEL_KV)
API_TOKEN=""             # used by the cftunnel container only. Needs:
                         #   Workers KV Storage:Edit
                         # (deploying the Worker uses `wrangler login`, not this token)

# Shared with the Worker (`wrangler secret put PROXY_TUNNEL_SECRET`, same value).
# 24+ chars of A-Z a-z 0-9 _ -  (try: openssl rand -hex 32).
# The Worker stamps it as X-Tunnel-Secret; nginx drops (444) any request without it,
# which kills direct hits on the public quick-tunnel hostname.
PROXY_TUNNEL_SECRET=""

# Fixed Host header the tunnel forwards to nginx (nginx matches it as
# server_name). Quick-tunnel hostnames change every restart, so keep this set.
HTTP_HOST_HEADER="proxy-cftunnel"
